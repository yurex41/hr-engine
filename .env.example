# Copy to .env and fill in. NEVER commit .env to git.

# Web UI logins, comma-separated "username:password" pairs.
# Put YOURSELF FIRST — existing single-user data is migrated into the first
# user's workspace. Usernames: lowercase letters, digits, "-", "_".
# Example: APP_USERS=yurek:LongRandomPw1,alice:LongRandomPw2,bob:LongRandomPw3
APP_USERS=

# Claude API key shared by all users (you pay for everyone's runs).
ANTHROPIC_API_KEY=
# Optional: per-user key override so friends pay for their own usage.
# Variable name is ANTHROPIC_API_KEY_<USERNAME uppercased, "-" becomes "_">.
# ANTHROPIC_API_KEY_ALICE=

# Full JSON of your Google OAuth *Web application* client
# (Google Cloud Console → APIs & Services → Credentials → Download JSON,
#  then paste the whole single-line JSON here)
GOOGLE_CLIENT_JSON=

# Public URL of the app, no trailing slash — used to build the OAuth redirect
# e.g. https://hr.example.com  or  https://hr-engine.onrender.com
PUBLIC_BASE_URL=
